  author = {Sullivan, Daniel C. and Obuchowski, Nancy A. and Kessler, Larry G. and Raunig, David L. and Gatsonis, Constantine and Huang, Erich P. and Kondratovich, Marina and McShane, Lisa M. and Reeves, Anthony P. and Barboriak, Daniel P. and Guimaraes, Alexander R. and Wahl, Richard L. and {For the RSNA-QIBA Metrology Working Group}},
