@article{santelliAccelerating4DFlow2016,
  title = {Accelerating {{4D}} Flow {{MRI}} by Exploiting Vector Field Divergence Regularization},
  author = {Santelli, Claudio and Loecher, Michael and Busch, Julia and Wieben, Oliver and Schaeffter, Tobias and Kozerke, Sebastian},
  date = {2016-01},
  journaltitle = {Magnetic Resonance in Medicine},
  shortjournal = {Magn Reson Med},
  volume = {75},
  number = {1},
  eprint = {25684112},
  eprinttype = {pubmed},
  pages = {115--125},
  issn = {1522-2594},
  doi = {10.1002/mrm.25563},
  abstract = {PURPOSE: To improve velocity vector field reconstruction from undersampled four-dimensional (4D) flow MRI by penalizing divergence of the measured flow field. THEORY AND METHODS: Iterative image reconstruction in which magnitude and phase are regularized separately in alternating iterations was implemented. The approach allows incorporating prior knowledge of the flow field being imaged. In the present work, velocity data were regularized to reduce divergence, using either divergence-free wavelets (DFW) or a finite difference (FD) method using the ℓ1-norm of divergence and curl. The reconstruction methods were tested on a numerical phantom and in vivo data. Results of the DFW and FD approaches were compared with data obtained with standard compressed sensing (CS) reconstruction. RESULTS: Relative to standard CS, directional errors of vector fields and divergence were reduced by 55-60\% and 38-48\% for three- and six-fold undersampled data with the DFW and FD methods. Velocity vector displays of the numerical phantom and in vivo data were found to be improved upon DFW or FD reconstruction. CONCLUSION: Regularization of vector field divergence in image reconstruction from undersampled 4D flow data is a valuable approach to improve reconstruction accuracy of velocity vector fields.},
  langid = {english},
  keywords = {4D flow,Algorithms,Aorta,Blood Flow Velocity,compressed sensing,Female,flow quantification,Humans,Image Enhancement,Image Interpretation Computer-Assisted,Magnetic Resonance Angiography,Male,phase regularization,Reproducibility of Results,Sensitivity and Specificity,undersampling,vector field divergence},
  file = {/Users/txn009/Zotero/storage/UZXDA753/Santelli et al. - 2016 - Accelerating 4D flow MRI by exploiting vector field divergence regularization.pdf}
}

@article{santelliRespiratoryBellowsRevisited2011,
  title = {Respiratory Bellows Revisited for Motion Compensation: Preliminary Experience for Cardiovascular {{MR}}},
  shorttitle = {Respiratory Bellows Revisited for Motion Compensation},
  author = {Santelli, Claudio and Nezafat, Reza and Goddu, Beth and Manning, Warren J. and Smink, Jouke and Kozerke, Sebastian and Peters, Dana C.},
  date = {2011-04},
  journaltitle = {Magnetic Resonance in Medicine},
  shortjournal = {Magn Reson Med},
  volume = {65},
  number = {4},
  eprint = {21413074},
  eprinttype = {pubmed},
  pages = {1097--1102},
  issn = {0740-3194},
  doi = {10.1002/mrm.22687},
  url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC3126878/},
  urldate = {2025-11-03},
  abstract = {For many cardiac MR applications, respiratory bellows-gating is attractive because it is widely available and not disruptive to or dependent on imaging. However, its use is uncommon in cardiac MR, because its accuracy has not been fully studied. Here, in 10 healthy subjects, the bellows and respiratory navigator (NAV) the displacement of the diaphragm and heart were simultaneously monitored, during single-shot imaging. Furthermore, bellows-gated and NAV-gated coronary MRI were compared, using a retrospective reconstruction at identical efficiency. There was a strong linear relationship for both the NAV and the abdominal bellows with the diaphragm (R=0.90±0.05 bellows, R=0.98±0.01 NAV, p{$<$}0.001) and the heart (R=0.89±0.06 bellows, R= 0.96±0.02 NAV, p=0.004); thoracic bellows correlated less strongly. The image quality of bellows-gated coronary MRI was similar to NAV-gated, and superior to no-gating (p{$<$}0.01). In conclusion, bellows provides a respiratory monitor which is highly correlated with the NAV, and suitable for respiratory-compensation in selected cardiac MR applications.},
  pmcid = {PMC3126878},
  file = {/Users/txn009/Zotero/storage/WEMUG4E9/Santelli et al. - 2011 - Respiratory bellows revisited for motion compensation preliminary experience for cardiovascular MR.pdf}
}

