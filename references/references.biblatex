  title = {High {{Spatial}} and {{Temporal Resolution Cardiac Cine MRI}} from {{Retrospective Reconstruction}} of {{Data Acquired}} in {{Real-time}} Using {{Motion Correction}} and {{Re-Sorting}} - {{PMC}}},
