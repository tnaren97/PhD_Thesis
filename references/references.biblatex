  title = {Noninvasive Pulse Wave Analysis for the Determination of Central Artery Stiffness},
  author = {Wittrock, Marc and Scholze, Alexandra and Compton, Friederike and Schaefer, Juergen-Heiner and Zidek, Walter and Tepel, Martin},
