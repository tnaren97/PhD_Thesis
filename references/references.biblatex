  urldate = {2026-03-29},
  abstract = {Conventional four-dimensional (4D) flow magnetic resonance imaging (MRI) is limited by long scan times, particularly in pediatric congenital heart disease (CHD) patients.},
  langid = {english},
  keywords = {4D flow magnetic resonance imaging,Cardiovascular,Compressed sensing,Congenital heart disease,Flow quantifications,Magnetic resonance imaging,Pediatrics},
  file = {/Users/txn009/Zotero/storage/LQLCNCRT/Rastegar Jooybari et al. - 2025 - Highly accelerated 4D flow MRI with respiratory compensation and cardiac view sharing a cross-secti.pdf}
