@inproceedings{narenEffectTemporalResolution,
  title = {Effect of {{Temporal Resolution}} on {{Flow-Area Aortic Pulse Wave Velocity Measures Using Phase Contrast}} and {{Balanced SSFP MRI}}: {{A Preliminary Study}}},
  shorttitle = {Effect of {{Temporal Resolution}} on {{Flow-Area Aortic Pulse Wave Velocity Measures Using Phase Contrast}} and {{Balanced SSFP MRI}}},
  author = {Naren, Tarun and Roberts, Grant and Wieben, Oliver},
  pages = {0796},
  location = {London, England, UK},
  doi = {10.58530/2022/0796},
  url = {https://archive.ismrm.org/2022/0796.html},
  urldate = {2024-08-19},
  abstract = {The flow-area (QA) method is a promising phase contrast (PC) technique to assess local aortic pulse wave velocity (PWV). However, validation for reduced temporal resolutions is lacking. Data analysis and automated post-processing are compromised because of varying PC image quality throughout the cardiac cycle. In this study, we acquire PC and bSSFP data at three temporal resolutions and measure QAPWV using PC data alone and by combining PC flow measures with bSSFP areas. We found that the highest temporal resolution datasets (10ms) provide the most accurate PWV measures and the method combining bSSFP and PC was less accurate.},
  eventtitle = {Joint {{Annual Meeting ISMRM-ESMRMB ISMRT}} 31st {{Annual Meeting}}},
  langid = {english}
}

@article{nelsonNoninvasiveMeasurementCentral2010,
  title = {Noninvasive {{Measurement}} of {{Central Vascular Pressures With Arterial Tonometry}}: {{Clinical Revival}} of the {{Pulse Pressure Waveform}}?},
  shorttitle = {Noninvasive {{Measurement}} of {{Central Vascular Pressures With Arterial Tonometry}}},
  author = {Nelson, Matthew R. and Stepanek, Jan and Cevette, Michael and Covalciuc, Michael and Hurst, R. Todd and Tajik, A. Jamil},
  date = {2010-05},
  journaltitle = {Mayo Clinic Proceedings},
  shortjournal = {Mayo Clinic Proceedings},
  volume = {85},
  number = {5},
  pages = {460--472},
  issn = {00256196},
  doi = {10.4065/mcp.2009.0336},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0025619611603339},
  urldate = {2024-08-19},
  langid = {english},
